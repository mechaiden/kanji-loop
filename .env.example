# Copy this file to .env.local and paste your key in.
#
#   cp .env.example .env.local
#
# Get a key at https://console.anthropic.com -> Settings -> API keys.
# .env.local is gitignored, so your key stays out of version control.
#
# Restart `npm run dev` after changing this file — Next.js only reads it at startup.
ANTHROPIC_API_KEY=sk-ant-...
